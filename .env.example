# OANDA v20 REST API
# Practice is the safe default. Create a personal token and account in your OANDA practice account.
OANDA_ACCOUNT_ID=
OANDA_API_TOKEN=
OANDA_ENVIRONMENT=practice

# Live execution is disabled unless both values explicitly opt in and the UI confirms each order.
OANDA_ALLOW_LIVE=false

# Deriv official WebSocket API
DERIV_APP_ID=
DERIV_API_TOKEN=

# Authenticated local MT5/MT4 terminal bridge
MT5_BRIDGE_URL=
MT5_BRIDGE_TOKEN=
MT4_BRIDGE_URL=
MT4_BRIDGE_TOKEN=
