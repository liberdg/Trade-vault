# OANDA v20 REST API
# Practice is the safe default. Create a personal token and account in your OANDA practice account.
OANDA_ACCOUNT_ID=
OANDA_API_TOKEN=
OANDA_ENVIRONMENT=practice

# Live execution is disabled unless both values explicitly opt in and the UI confirms each order.
OANDA_ALLOW_LIVE=false

# Deriv official WebSocket API (required for forex/metal candle feeds; no public app-id fallback)
DERIV_APP_ID=
# Optional server-side PAT for Deriv connection tests when the client does not send a token
DERIV_API_TOKEN=

# Authenticated local MT5/MT4 terminal bridge
MT5_BRIDGE_URL=
MT5_BRIDGE_TOKEN=
MT4_BRIDGE_URL=
MT4_BRIDGE_TOKEN=

# Optional shared secret for order/status/close-all routes.
# When set, clients must send header: x-smrt-execution-secret: <value>
# Leave empty only for trusted local single-user development.
SMRT_EXECUTION_SECRET=
